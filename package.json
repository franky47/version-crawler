{
  "name": "version-crawler",
  "version": "0.0.0",
  "description": "Find what version of your package is used in a given repository.",
  "homepage": "https://version-crawler.47ng.com",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.8",
  "scripts": {
    "test": "bun test",
    "test:types": "tsc --noEmit",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "docker:build": "docker build -t version-crawler .",
    "docker:start": "docker run -p 3000:3000 version-crawler --name version-crawler"
  },
  "engines": {
    "bun": "1.3.8"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "arktype": "^2.1.29",
    "elysia": "latest",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "bun-types": "latest",
    "msw": "^2.12.9",
    "typescript": "^5.9.3"
  }
}
